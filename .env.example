# Hugging Face access token, required for speaker diarization (pyannote models).
# 1. Create a token at https://huggingface.co/settings/tokens (read access is enough).
# 2. Accept the terms of both gated models while logged in:
#      https://huggingface.co/pyannote/speaker-diarization-3.1
#      https://huggingface.co/pyannote/segmentation-3.0
# 3. Copy this file to .env and paste the token below.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: use a specific ffmpeg build (e.g. Homebrew's keg-only ffmpeg-full,
# which includes libass and is required for --burn-subs on macOS).
# FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
